# Vira Forms — copy to .env.local and fill in your values
# هرگز کلیدهای واقعی را در گیت commit نکنید

# ---------- Builder app → MySQL (XAMPP) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_META_NAME=vira_forms
DB_DATA_NAME=Forms

# ---------- Defaults baked into generated PHP exports ----------
PHP_DB_HOST=localhost
PHP_DB_PORT=3307
PHP_DB_USER=root
PHP_DB_PASSWORD=
PHP_DB_NAME=Forms

# ---------- SMS.ir defaults ----------
SMS_API_KEY=
SMS_LINE_NUMBER=
